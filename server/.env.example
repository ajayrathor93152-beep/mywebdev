# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the app (Nginx, Render, Railway = 1). 0 locally.
TRUST_PROXY=0

# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/agency

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of exact origins allowed to call the API with credentials.
CLIENT_ORIGINS=http://localhost:5173

# ── JWT ───────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-64-random-bytes-hex
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-64-random-bytes-hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Refresh cookie ────────────────────────────────────────
# "strict" when client + API share a site (e.g. example.com + api.example.com).
# "none" only if they live on different sites (forces Secure).
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# ── Email (leave SMTP_HOST empty to skip sending in dev) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aurex Studio <no-reply@aurex.studio>"
MAIL_TO=you@yourdomain.com

# ── First admin (used only by `npm run seed:admin`) ───────
ADMIN_NAME=Founder
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change-this-to-a-long-passphrase
